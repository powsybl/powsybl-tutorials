<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.powsybl.tutorials</groupId>
        <artifactId>powsybl-tutorials</artifactId>
        <version>2.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dynawo</artifactId>

    <!-- These properties are only needed to run the tutorial from the command line with mvn exec:exec@run -->
    <properties>
        <exec.cleanupDaemonThreads>false</exec.cleanupDaemonThreads>
        <exec.mainClass>com.powsybl.tutorials.dynawo.DynamicSimulation</exec.mainClass>
        <exec.optionalArgument>${env.HOME}/dynawo/dynawo</exec.optionalArgument>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <systemProperties>
                        <systemProperty>
                            <key>powsybl.config.dirs</key>
                            <value>${project.basedir}/src/main/resources</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Platform configuration: to load config from ~/.itools/config.yml or from other path if provided -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-config-classic</artifactId>
        </dependency>
        <!-- Tutorials report bundles -->
        <dependency>
            <groupId>com.powsybl.tutorials</groupId>
            <artifactId>commons</artifactId>
        </dependency>

        <!-- Dynawo dynamic provider-->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-dynawo-simulation</artifactId>
        </dependency>
        <!-- dynamic groovy -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-dynawo-dsl</artifactId>
        </dependency>


        <!-- IIDM Network implementation -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-iidm-impl</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- For SA -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-contingency-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-security-analysis-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-dynamic-security-analysis</artifactId>
        </dependency>
        <!-- Dynawo security analysis provider-->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-dynawo-security-analysis</artifactId>
        </dependency>
    </dependencies>

</project>